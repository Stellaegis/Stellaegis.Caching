<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Caching</RootNamespace>
    <PackageId>Stellaegis.Caching</PackageId>
    <Description>Stellaegis caching primitives: a size-bounded in-memory cache with a long backstop TTL, segment invalidation support, and built-in metrics.</Description>
    <PackageTags>stellaegis;caching;memorycache;bounded;lru</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Stellaegis.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Stellaegis.Primitives" />
  </ItemGroup>

</Project>
